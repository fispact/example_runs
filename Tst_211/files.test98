# This is a sample of the new format 'files' file
# comment lines start with #,1, or *
#
# files can be referred to be either their name (e.g., 'crossec')
# or by their internal unit number 9 (e.g., '19'). 
#
# output files may either be named in this file, or
# have their names generated automatically from the fileroot
# given on the command line when executing fispact 
#
# binary decay and collapsed cross section files
arrayx    ARRAYXP
collapxo  COLLAPXP
collapxi  COLLAPXP
# index of nuclides
ind_nuc SHORTINDEX 
