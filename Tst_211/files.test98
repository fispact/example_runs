crossunc  ../../nuclear_data/EAF2010data/eaf_un_20100
crossec   ../../nuclear_data/EAF2010data/eaf_n_gxs_211_flt_20100
# netron flux spectrum
fluxes    fluxes
# fission yield and associations------
fissyld  ../../nuclear_data/EAF2010data/eaf_n_fis_20100
asscfy  ../../nuclear_data/EAF2010data/eaf_n_asscfy_20100
# search for the sequence with suffices .002, .003, etc
decay  ../../nuclear_data/EAF2010data/eaf_dec_20100.001
# transport, clearance and hazards data
a2data  ../../nuclear_data/EAF2010data/eaf_a2_20100
clear  ../../nuclear_data/EAF2010data/eaf_clear_20100
hazards  ../../nuclear_data/EAF2010data/eaf_haz_20100
